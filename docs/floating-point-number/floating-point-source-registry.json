{
  "schemaVersion": 1,
  "requirement": "TAP-12568",
  "scope": "binary32 and binary64 floating point only; decimal floating point and other numeric types are out of scope",
  "allowlistFile": "tapdata/docs/floating-point-number/floating-point-spec-allowlist.json",
  "classificationRules": {
    "actual_binary32": {
      "tapType": "TapFloat",
      "bit": 32,
      "storageBytes": 4,
      "effectivePrecision": 7,
      "reason": "IEEE 754 binary32 or a source type whose official definition is exactly 32-bit single precision"
    },
    "actual_binary64": {
      "tapType": "TapDouble",
      "bit": 64,
      "storageBytes": 8,
      "effectivePrecision": 15,
      "reason": "IEEE 754 binary64 or a source type whose official definition is exactly 64-bit double precision"
    },
    "parameterized_floating": {
      "mapping": "TapFloatingPoint",
      "reason": "The source precision parameter is binary precision; the resolver must preserve the source range and split at the vendor-defined single/double boundary"
    },
    "out_of_scope": {
      "requirement": "A source-file/type-specific allowlist entry with officialUrl and reason is mandatory"
    },
    "false_positive": {
      "requirement": "A source-file/type-specific allowlist entry is mandatory; the type must not be changed merely because its name contains Float"
    }
  },
  "families": {
    "sqlserver": {
      "officialUrls": ["https://learn.microsoft.com/en-us/sql/t-sql/data-types/float-and-real-transact-sql"],
      "rule": "real and float(1..24) are binary32; float(25..53) and default float are binary64; the resolver default is 53"
    },
    "mysql_compatible": {
      "officialUrls": ["https://dev.mysql.com/doc/refman/8.4/en/floating-point-types.html"],
      "rule": "FLOAT is binary32 and DOUBLE is binary64; FLOAT(p) uses the vendor binary-precision boundary; M,D is display/scale semantics and is not copied to TapFloat/TapDouble"
    },
    "postgres_compatible": {
      "officialUrls": ["https://www.postgresql.org/docs/17/datatype-numeric.html"],
      "rule": "real/float4 are binary32 and double precision/float8 are binary64; float(p) preserves vendor binary-precision semantics"
    },
    "oracle": {
      "officialUrls": ["https://docs.oracle.com/en/database/oracle/oracle-database/21/sqlrf/Data-Types.html"],
      "rule": "BINARY_FLOAT is binary32 and BINARY_DOUBLE is binary64; FLOAT(p) is a NUMBER subtype and remains TapNumber"
    },
    "hive_columnar": {
      "officialUrls": ["https://cwiki.apache.org/confluence/display/Hive/LanguageManual+Types", "https://github.com/apache/parquet-format/blob/master/LogicalTypes.md"],
      "rule": "FLOAT is binary32 and DOUBLE is binary64; logical/physical annotations do not become decimal scale"
    },
    "clickhouse": {
      "officialUrls": ["https://clickhouse.com/docs/sql-reference/data-types/float"],
      "rule": "Float32 is binary32 and Float64 is binary64; unsupported display parameters are not retained as decimal attributes"
    },
    "bigquery": {
      "officialUrls": ["https://cloud.google.com/bigquery/docs/reference/standard-sql/data-types"],
      "rule": "FLOAT64 is binary64"
    },
    "mongodb": {
      "officialUrls": ["https://www.mongodb.com/docs/manual/reference/bson-types/"],
      "rule": "BSON Double is binary64; Decimal128 is decimal and remains outside this change"
    },
    "elasticsearch": {
      "officialUrls": ["https://www.elastic.co/guide/en/elasticsearch/reference/current/number.html"],
      "rule": "float is binary32 and double is binary64; half_float and scaled_float require the explicit out-of-scope allowlist"
    },
    "avro": {
      "officialUrls": ["https://avro.apache.org/docs/1.11.1/specification/"],
      "rule": "Avro float is binary32 and double is binary64"
    },
    "snowflake": {
      "officialUrls": ["https://docs.snowflake.com/en/sql-reference/data-types-numeric"],
      "rule": "FLOAT is the connector's binary64 path; DECFLOAT is decimal and is allowlisted outside this requirement"
    },
    "api_or_sdk": {
      "officialUrls": [],
      "rule": "Only an actual SDK/protocol Float or Double payload establishes width; a logical field label without such evidence is allowlisted and cannot be inferred"
    },
    "dameng": {
      "officialUrls": ["https://eco.dameng.com/document/dm/zh-cn/pm/dm8/sql-language"],
      "rule": "DM REAL/BINARY_FLOAT are binary32 and DM DOUBLE/BINARY_DOUBLE/DOUBLE PRECISION are binary64; decimal types remain TapNumber"
    },
    "db2": {
      "officialUrls": ["https://www.ibm.com/docs/en/db2/11.5?topic=elements-data-types"],
      "rule": "Db2 REAL is binary32 and DOUBLE is binary64; decimal attributes are not copied to the platform floating type"
    },
    "db2i": {
      "officialUrls": ["https://www.ibm.com/docs/en/i/7.4.0?topic=types-data-types"],
      "rule": "Db2 for i FLOAT(p) preserves IBM binary precision semantics and DOUBLE is binary64"
    },
    "gbase8s": {
      "officialUrls": ["https://www.gbase.cn/document"],
      "rule": "SMALLFLOAT is the 32-bit type and FLOAT is the 64-bit type for this connector's source definitions"
    },
    "hana": {
      "officialUrls": ["https://help.sap.com/docs/SAP_HANA_PLATFORM"],
      "rule": "SAP HANA REAL is binary32 and DOUBLE is binary64"
    },
    "informix": {
      "officialUrls": ["https://www.ibm.com/docs/en/informix-servers/14.10.0?topic=types-approximate-numbers-float-smallfloat"],
      "rule": "Informix SMALLFLOAT/REAL is binary32, while FLOAT/DOUBLE PRECISION is binary64; the old bit=16 declaration was incorrect"
    },
    "iris": {
      "officialUrls": ["https://docs.intersystems.com/irislatest/csp/docbook/DocBook.UI.Page.cls?KEY=RSQL_datatype"],
      "rule": "IRIS double is binary64 for the connector path"
    },
    "yashandb": {
      "officialUrls": ["https://doc.yashandb.com/yashandb/23.2/zh/Development-Guide/SQL-Reference-Manual/Data-Types/Numeric-Types.html"],
      "rule": "YashanDB FLOAT(p) preserves its documented p range and promotion boundary; FLOAT is binary32 and DOUBLE is binary64"
    }
  },
