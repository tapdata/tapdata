            "interval": 300,
            "unit": "SECOND",
            "emailAlarmTitle": "【Tapdata Notification: Increment progress stuck】{taskName}",
            "emailAlarmContent": "<div style=\"max-width: 600px; margin: 20px auto; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 32px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #374151; line-height: 1.6;\" class=\"email-content-root\"><div style=\"text-align: center; margin-bottom: 16px;\" class=\"email-root-header\"><div style=\"display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: #fef3c7; border-radius: 50%; font-size: 24px;\" class=\"email-root-header-icon\"><p class=\"ace-line\" style=\"margin: 0; font-size: inherit;\">&#9203;</p></div></div><h1 style=\"font-size: 20px; font-weight: 600; color: #111827; text-align: center; margin: 0 0 8px 0;\">Increment progress stuck</h1><p class=\"ace-line\" style=\"color: #6b7280; font-size: 14px; text-align: center; margin: 0 0 32px 0;\">The task incremental progress has not advanced for a while; a fallback restart was triggered.</p><hr style=\"height: 1px; background: #f3f4f6; border: none; margin: 24px 0;\"><p class=\"ace-line\" style=\"font-size: 14px; margin: 16px 0 4px 0;\"><strong style=\"font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;\">Task Name</strong></p><p class=\"ace-line\" style=\"margin: 8px 0; font-size: 14px;\"><span data-variable=\"taskName\" variablename=\"taskName\" data-system-variable=\"true\" class=\"system-variable\" contenteditable=\"false\">{taskName}</span></p><p class=\"ace-line\" style=\"font-size: 14px; margin: 16px 0 4px 0;\"><strong style=\"font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;\">Task Id</strong></p><p class=\"ace-line\" style=\"margin: 8px 0; font-size: 14px;\"><span data-variable=\"taskId\" variablename=\"taskId\" data-system-variable=\"true\" class=\"system-variable\" contenteditable=\"false\">{taskId}</span></p><p class=\"ace-line\" style=\"font-size: 14px; margin: 16px 0 4px 0;\"><strong style=\"font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;\">Stuck Duration</strong></p><p class=\"ace-line\" style=\"margin: 8px 0; font-size: 14px;\"><span data-variable=\"idleDuration\" variablename=\"idleDuration\" data-system-variable=\"true\" class=\"system-variable\" contenteditable=\"false\">{idleDuration}</span></p><p class=\"ace-line\" style=\"font-size: 14px; margin: 16px 0 4px 0;\"><strong style=\"font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;\">Monitored Units</strong></p><p class=\"ace-line\" style=\"margin: 8px 0; font-size: 14px;\"><span data-variable=\"units\" variablename=\"units\" data-system-variable=\"true\" class=\"system-variable\" contenteditable=\"false\">{units}</span></p><p class=\"ace-line\" style=\"font-size: 14px; margin: 16px 0 4px 0;\"><strong style=\"font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;\">Last Progress Time</strong></p><p class=\"ace-line\" style=\"margin: 8px 0; font-size: 14px;\"><span data-variable=\"lastProgressTime\" variablename=\"lastProgressTime\" data-system-variable=\"true\" class=\"system-variable\" contenteditable=\"false\">{lastProgressTime}</span></p><p class=\"ace-line\" style=\"font-size: 14px; margin: 16px 0 4px 0;\"><strong style=\"font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;\">Alarm Time</strong></p><p class=\"ace-line\" style=\"margin: 8px 0; font-size: 14px;\"><span data-variable=\"alarmDate\" variablename=\"alarmDate\" data-system-variable=\"true\" class=\"system-variable\" contenteditable=\"false\">{alarmDate}</span></p><hr style=\"height: 1px; background: #f3f4f6; border: none; margin: 24px 0;\"><p class=\"ace-line\" style=\"color: #9ca3af; font-size: 12px; line-height: 1.4; text-align: center; margin: 16px 0 0 0;\"><em style=\"font-style: normal;\">This email is sent by TapData</em></p></div>",
            "variables": [
